# Backend configuration.
# Copy this file to `.env` and adjust as needed.

# SQLAlchemy connection string for the Dockerized Postgres (see docker-compose.yml).
DATABASE_URL=postgresql+psycopg://lab1a:lab1a_password@localhost:5432/lab1a

# Secret used to sign JWTs. Use a long random value in real projects.
JWT_SECRET=change-me-to-a-long-random-string

# How long (in minutes) an access token stays valid.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of origins allowed by CORS (the frontend origin).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
