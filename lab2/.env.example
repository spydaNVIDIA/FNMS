# Run scripts/setup.sh to generate local service/JWT secrets. Never commit .env.
DATABASE_URL=postgresql+psycopg://lab2:lab2_local@127.0.0.1:5434/lab2
JWT_SECRET=
RESEARCHER_TOKEN=
VERIFIER_TOKEN=
MODEL_API_KEY=
TAVILY_API_KEY=
MODEL_BASE_URL=https://api.groq.com/openai/v1
MODEL_NAME=openai/gpt-oss-120b
MODEL_MIN_INTERVAL_SECONDS=45
# Optional runtime overrides; the launcher otherwise reads these from config.yaml.
# MODEL_MAX_OUTPUT_TOKENS=1800
# SEARCH_MAX_RESULTS=5
# FETCH_TIMEOUT_SECONDS=20
RESEARCHER_URL=http://127.0.0.1:8011
VERIFIER_URL=http://127.0.0.1:8012
# Set true only for free-tier-only keys or after setting hard provider spending caps.
LIVE_CALLS_APPROVED=false
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Optional CLI override; default uses the seeded local grader account.
TRACKER_USERNAME=NYUgrader
TRACKER_PASSWORD=Courant2026!

